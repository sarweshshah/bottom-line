{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "paths": {
      "@shared/*": ["./src/shared/*"]
    },
    "baseUrl": ".",
    "typeRoots": ["./node_modules/@figma"]
  },
  "include": ["src/plugin", "src/shared"]
}
